@PACKAGE_INIT@

# The substitute fonts installed with it, for PdfaOptions::fonts. Set before the dependencies are
# found: their config files reset PACKAGE_PREFIX_DIR.
set_and_check(FYNEPDF_PDFA_FONTS_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/fynepdf-pdfa/fonts")

# fynepdf-pdfa, a static library: its dependencies come with it.
include(CMakeFindDependencyMacro)
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(qpdf CONFIG)
find_dependency(JPEG)
if(@FYNEPDF_PDFA_FOUND_OPENJPEG@)
    find_dependency(OpenJPEG CONFIG)
endif()
if(@FYNEPDF_PDFA_FOUND_LCMS@)
    find_dependency(LCMS2)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/fynepdf_pdfaTargets.cmake")

# A static qpdf names zlib and libjpeg bare (-lz -ljpeg): they are found in its own folder.
get_target_property(_fynepdf_pdfa_qpdf_type qpdf::libqpdf TYPE)
if(_fynepdf_pdfa_qpdf_type STREQUAL "STATIC_LIBRARY")
    set_property(TARGET fynepdf::pdfa APPEND PROPERTY INTERFACE_LINK_DIRECTORIES "$<TARGET_LINKER_FILE_DIR:qpdf::libqpdf>")
endif()

check_required_components(fynepdf_pdfa)
